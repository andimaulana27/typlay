# Canonical origin used for metadata. Local dev serves on port 3080.
NEXT_PUBLIC_SITE_URL=http://localhost:3080

# Create a separate Supabase project for Typlay, then apply
# supabase/migrations yourself. Never expose the secret key with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use this instead of NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public contact address shown on About / Privacy / Terms (AdSense review expects one).
NEXT_PUBLIC_CONTACT_EMAIL=

# Google AdSense. Ads, the loader script and /ads.txt stay off until the client id is set.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
